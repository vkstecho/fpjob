{
  "rules": {
    ".read": true,
    ".write": "auth != null",

    "login_requests": {
      ".write": true
    },

    "otpLog": {
      ".read": "auth != null && auth.token.phone_number === '+918929397949'",
      ".write": true
    },

    "managers": {
      ".write": "auth != null && auth.token.phone_number === '+918929397949'",
      "$uid": {
        ".read": "auth != null && (auth.token.phone_number === '+918929397949' || auth.uid === $uid)"
      }
    },

    "chats": {
      ".read": "auth != null",
      "$mid": {
        ".write": "auth != null && (auth.token.phone_number === '+918929397949' || (!data.exists() && ('+91'+newData.child('authorPhone').val()) === auth.token.phone_number) || (data.exists() && ('+91'+data.child('authorPhone').val()) === auth.token.phone_number))"
      }
    },

    "contacts": {
      ".write": "auth != null && auth.token.phone_number === '+918929397949'"
    },

    "users": {
      ".indexOn": ["phone", "status", "category"],
      "$uid": {
        ".write": "auth != null && (auth.token.phone_number === '+918929397949' || (root.child('managers').child(auth.uid).val() === true && (!data.exists() || (data.child('role').val() !== 'admin' && data.child('role').val() !== 'manager'))) || (!data.exists() && ('+91'+newData.child('phone').val()) === auth.token.phone_number) || (data.exists() && ('+91'+data.child('phone').val()) === auth.token.phone_number))"
      }
    },
    "jobs": {
      ".indexOn": ["status", "postedAt", "type"]
    },
    "notifications": {
      ".indexOn": ["status", "createdAt"]
    }
  }
}
