rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function signedIn() {
      return request.auth != null && request.auth.token.phone_number != null;
    }

    function phone() {
      return request.auth.token.phone_number;
    }

    // Must match js/config.js SUPER_ADMIN
    function isSuperAdmin() {
      return signedIn() && phone() == '+918929397949';
    }

    function memberDoc(uid) {
      return get(/databases/$(database)/documents/members/$(uid)).data;
    }

    function memberExists(uid) {
      return exists(/databases/$(database)/documents/members/$(uid));
    }

    // Active member of the network (or super admin)
    function isActiveMember() {
      return signedIn() && (
        isSuperAdmin() ||
        (memberExists(phone()) && memberDoc(phone()).active != false)
      );
    }

    function isAdmin() {
      return signedIn() && (
        isSuperAdmin() ||
        (memberExists(phone()) && memberDoc(phone()).role == 'admin' && memberDoc(phone()).active != false)
      );
    }

    function isOwner(uid) {
      return signedIn() && phone() == uid;
    }

    // Fields a normal member may change on their own profile
    function onlySelfProfileKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'about', 'company', 'designation', 'department', 'photoURL', 'lastActive', 'lastReadAt']);
    }

    function onlyPresenceKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['lastActive', 'lastReadAt']);
    }

    // ---- members (public directory; doc id = E.164 phone) ----
    match /members/{uid} {
      // All active members can list/read the directory
      allow read: if isActiveMember();

      // Super admin bootstrap: create own admin doc if missing
      allow create: if isSuperAdmin() && isOwner(uid)
        || isAdmin();

      // Own profile / presence updates
      allow update: if isActiveMember() && isOwner(uid) && onlySelfProfileKeys()
        // Admins may edit any member (role, active, profile fields)
        || isAdmin();

      // Soft-remove is done by delete or active:false; only admin (not self-demote super)
      allow delete: if isAdmin() && uid != '+918929397949';
    }

    // ---- private HR fields (admin only) ----
    match /memberPrivate/{uid} {
      allow read, write: if isAdmin();
    }

    // ---- group chat messages ----
    match /messages/{msgId} {
      allow read: if isActiveMember();

      allow create: if isActiveMember()
        && request.resource.data.senderPhone == phone()
        && request.resource.data.keys().hasAll(['senderPhone', 'createdAt', 'deleted'])
        && request.resource.data.deleted == false;

      // Soft-delete: author or admin may clear content
      // Reactions: any active member may update the reactions map only
      allow update: if isActiveMember() && (
        // soft delete by author or admin
        (
          (resource.data.senderPhone == phone() || isAdmin())
          && request.resource.data.deleted == true
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['deleted', 'text', 'imageURL', 'reactions'])
        )
        ||
        // reactions only
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.senderPhone == resource.data.senderPhone
          && request.resource.data.createdAt == resource.data.createdAt
        )
      );

      allow delete: if isAdmin();
    }

    // ---- job board ----
    match /jobs/{jobId} {
      allow read: if isActiveMember();

      allow create: if isActiveMember()
        && request.resource.data.postedBy == phone()
        && request.resource.data.keys().hasAll(['title', 'postedBy', 'createdAt']);

      allow update: if isActiveMember() && (
        // interest toggle — only interested array changes
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interested'])
        ||
        // poster or admin may edit job fields
        (resource.data.postedBy == phone() || isAdmin())
      );

      allow delete: if isActiveMember() && (
        resource.data.postedBy == phone() || isAdmin()
      );
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
